# Generated verbatim from the pinned Ghostty source; preserve upstream bytes.
native/libghostty/prebuilt/*/include/ghostty/vt.h -whitespace

# Git patches are applied verbatim on Linux and Windows runners.
*.patch text eol=lf
src-app/src/diff/queries/** text eol=lf
src-app/src/diff/fixtures/*.scm text eol=lf
scripts/sync-zed-queries.sh text eol=lf
scripts/sync-zed-queries.ps1 text eol=lf

crates/paneflow-highlights/c/** text eol=lf
crates/paneflow-highlights/src/tables.rs text eol=lf
scripts/sync-pierre-highlights.sh text eol=lf
scripts/sync-pierre-highlights.ps1 text eol=lf
# Generated by `paneflow api stubs`; the drift test compares it byte for byte.
protocol/paneflow.d.lua text eol=lf

# Source guards and protocol snapshots compare these files line by line and
# byte for byte, so a Windows checkout keeps them LF.
*.rs text eol=lf
protocol/** text eol=lf
crates/paneflow-api/tests/decision_table.txt text eol=lf
