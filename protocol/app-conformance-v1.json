{
  "schema": 1,
  "protocol": "paneflow-app",
  "version": 1,
  "description": "Cases the window's JSON-RPC endpoint must pass. src-app/src/app/ipc_handler/conformance.rs starts a real app with display-only terminals in its own process and state home, once with the scripting and orchestration gates closed and once with PANEFLOW_IPC_SCRIPTING=1, and runs every case over the real socket or named pipe in file order. A result expectation pins the type of every field, nested ones included; values pins exact field values; a case whose expectation or gates no runner reads is a failure naming the case, not a skip. `$surface` stands for the first surface of the shown workspace at the time the case runs.",
  "cases": [
    {
      "id": "system_ping",
      "summary": "system.ping answers on the connection thread with pong.",
      "method": "system.ping",
      "expect": {
        "result": {
          "pong": "boolean"
        }
      }
    },
    {
      "id": "system_identify",
      "summary": "system.identify names the app, its version and the wire protocol.",
      "method": "system.identify",
      "expect": {
        "result": {
          "name": "string",
          "version": "string",
          "protocol": "string"
        }
      }
    },
    {
      "id": "system_counters",
      "summary": "system.counters returns every work counter the app keeps.",
      "method": "system.counters",
      "expect": {
        "result": {
          "counters": {
            "root_renders": "integer",
            "sidebar_renders": "integer",
            "host_agent_snapshots_applied": "integer",
            "session_list_calls": "integer",
            "git_spawns": {
              "total": "integer",
              "probe": "integer",
              "user_action": "integer",
              "by_subcommand": {
                "add": "integer",
                "branch": "integer",
                "cat-file": "integer",
                "clone": "integer",
                "config": "integer",
                "diff": "integer",
                "diff-index": "integer",
                "for-each-ref": "integer",
                "log": "integer",
                "ls-files": "integer",
                "merge-base": "integer",
                "rev-parse": "integer",
                "show": "integer",
                "status": "integer",
                "switch": "integer",
                "symbolic-ref": "integer",
                "worktree": "integer",
                "write-tree": "integer",
                "other": "integer"
              }
            },
            "process_spawns": "integer",
            "process_identity": {
              "pid": "integer",
              "started_at": "integer"
            }
          }
        }
      }
    },
    {
      "id": "system_capabilities_closed",
      "summary": "system.capabilities lists every method and reports both gates closed.",
      "method": "system.capabilities",
      "expect": {
        "result": {
          "scripting": "boolean",
          "orchestration": "boolean",
          "methods": [
            "string"
          ]
        },
        "values": {
          "scripting": false,
          "orchestration": false,
          "methods": [
            "system.ping",
            "system.capabilities",
            "system.identify",
            "system.counters",
            "workspace.list",
            "workspace.create",
            "workspace.select",
            "workspace.close",
            "workspace.current",
            "workspace.restore_layout",
            "workspace.up",
            "surface.list",
            "surface.read",
            "surface.search",
            "surface.rename",
            "surface.send_text",
            "surface.send_keystroke",
            "surface.split",
            "surface.focus",
            "surface.status",
            "fleet.list",
            "events.subscribe",
            "tmux.compat"
          ]
        }
      }
    },
    {
      "id": "workspace_list",
      "summary": "workspace.list returns every workspace with index, title, cwd, pane count, active flag and space.",
      "method": "workspace.list",
      "expect": {
        "result": {
          "workspaces": [
            {
              "index": "integer",
              "title": "string",
              "cwd": "string",
              "panes": "integer",
              "active": "boolean",
              "space": "null"
            }
          ]
        }
      }
    },
    {
      "id": "workspace_current",
      "summary": "workspace.current returns the shown workspace with its layout document.",
      "method": "workspace.current",
      "expect": {
        "result": {
          "index": "integer",
          "title": "string",
          "cwd": "string",
          "panes": "integer",
          "space": "null",
          "layout": {
            "type": "string",
            "surfaces": [
              {
                "surface_type": "string",
                "name": "string",
                "command": "null",
                "cwd": "null",
                "env": "null",
                "focus": "boolean",
                "session": "string"
              }
            ]
          }
        }
      }
    },
    {
      "id": "surface_list",
      "summary": "surface.list returns the active workspace's surfaces with their identity and scope.",
      "method": "surface.list",
      "expect": {
        "result": {
          "pane_count": "integer",
          "workspace": "integer",
          "scope_workspace_id": "null",
          "surfaces": [
            {
              "surface_id": "integer",
              "name": "string",
              "title": "string",
              "cwd": "null",
              "cmd": "null",
              "workspace_id": "integer",
              "workspace": "integer",
              "scope": "string",
              "tab_id": "integer",
              "tab_title": "string",
              "space": "null",
              "sandboxed": "boolean"
            }
          ]
        }
      }
    },
    {
      "id": "surface_list_mistyped_workspace_id",
      "summary": "surface.list refuses a workspace_id that is not an integer.",
      "method": "surface.list",
      "params": {
        "workspace_id": "one"
      },
      "expect": {
        "error": {
          "code": -32602
        }
      }
    },
    {
      "id": "surface_read",
      "summary": "surface.read returns the trailing lines with their counts, eof, output generation and truncation flag.",
      "method": "surface.read",
      "params": {
        "surface_id": "$surface",
        "lines": 5,
        "fenced": false
      },
      "expect": {
        "result": {
          "text": "string",
          "lines": "integer",
          "total_lines": "integer",
          "eof": "boolean",
          "output_generation": "integer",
          "truncated": "boolean"
        }
      }
    },
    {
      "id": "surface_read_mistyped_lines",
