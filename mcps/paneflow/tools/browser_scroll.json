{
  "name": "browser_scroll",
  "description": "Scroll one browser page by bounded viewport deltas without taking keyboard focus.",
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": true,
    "readOnlyHint": false
  },
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "browser_id": {
        "maxLength": 64,
        "minLength": 1,
        "type": "string"
      },
      "generation": {
        "maximum": 9007199254740991,
        "minimum": 1,
        "type": "integer"
      },
      "x": {
        "maximum": 32768,
        "minimum": -32768,
        "type": "integer"
      },
      "y": {
        "maximum": 32768,
        "minimum": -32768,
        "type": "integer"
      },
      "delta_x": {
        "maximum": 32768,
        "minimum": -32768,
        "type": "integer"
      },
      "delta_y": {
        "maximum": 32768,
        "minimum": -32768,
        "type": "integer"
      }
    },
    "required": [
      "browser_id",
      "generation",
      "x",
      "y",
      "delta_x",
      "delta_y"
    ],
    "type": "object"
  }
}
