+            return;
+        };
+        if let Some(xim_handler) = state.xim_handler.as_mut() {
+            xim_handler.focused = false;
+            if xim_handler.connected {
+                ximc
+                    .unset_focus(xim_handler.im_id, xim_handler.ic_id)
+                    .ok();
+            }
+        } else {
+            log::error!("bug: xim handler not set in disable_ime");
+        }
+        state.ximc = Some(ximc);
+    }
