+    #[test]
+    fn synthetic_focus_requires_a_focused_parent_and_existing_child() {
+        for focused in [false, true] {
+            let mut nodes = new_builder();
+            let parent = accesskit::NodeId(1);
+            let child = accesskit::NodeId(2);
+            assert!(nodes.push(parent, test_node()));
+            if focused {
+                nodes.set_focus(parent);
+            }
+            let mut subtree = A11ySubtreeBuilder::new(parent, &mut nodes);
+            assert!(!subtree.set_active_descendant(child));
+            assert!(subtree.push_child(child, test_node()));
+            assert!(!subtree.set_active_descendant(parent));
+            assert_eq!(subtree.set_active_descendant(child), focused);
+            nodes.pop();
+            let update = nodes.finalize();
+            assert_eq!(update.focus, if focused { child } else { ROOT_NODE_ID });
+        }
     }
 
