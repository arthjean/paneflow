+/// A GPU resource produced outside GPUI and composed by the platform renderer.
+///
+/// The handle is type-erased so the scene stays independent of any graphics
+/// API; each platform renderer downcasts it to the resource type it created
+/// (for example a wgpu texture) and ignores handles it does not recognize.
+/// The generation lets producers retire a resource: a renderer must never
+/// present a surface whose generation is older than the one it was told is
+/// current, and dropping every clone releases the underlying resource.
+#[cfg(not(target_os = "macos"))]
+#[derive(Clone)]
+pub struct ExternalSurface {
+    id: u64,
+    generation: u64,
+    size: Size<crate::DevicePixels>,
+    handle: std::sync::Arc<dyn std::any::Any + Send + Sync>,
+}
+
+#[cfg(not(target_os = "macos"))]
+impl ExternalSurface {
+    /// Wrap a renderer-specific resource of `size` device pixels.
+    pub fn new(
+        generation: u64,
+        size: Size<crate::DevicePixels>,
+        handle: std::sync::Arc<dyn std::any::Any + Send + Sync>,
+    ) -> Self {
+        static NEXT_ID: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(1);
+        Self {
+            id: NEXT_ID.fetch_add(1, std::sync::atomic::Ordering::Relaxed),
+            generation,
+            size,
+            handle,
+        }
+    }
+
+    /// A process-unique identifier for this handle.
+    pub fn id(&self) -> u64 {
+        self.id
+    }
+
+    /// The producer generation this resource belongs to.
+    pub fn generation(&self) -> u64 {
+        self.generation
+    }
+
+    /// The resource size in device pixels.
+    pub fn size(&self) -> Size<crate::DevicePixels> {
+        self.size
+    }
+
+    /// The renderer-specific resource.
+    pub fn handle(&self) -> &std::sync::Arc<dyn std::any::Any + Send + Sync> {
+        &self.handle
+    }
+}
+
+#[cfg(not(target_os = "macos"))]
+impl std::fmt::Debug for ExternalSurface {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("ExternalSurface")
+            .field("id", &self.id)
+            .field("generation", &self.generation)
+            .field("size", &self.size)
+            .finish()
+    }
+}
+
+#[cfg(not(target_os = "macos"))]
+impl PartialEq for ExternalSurface {
+    fn eq(&self, other: &Self) -> bool {
+        self.id == other.id && self.generation == other.generation
+    }
+}
+
+#[cfg(not(target_os = "macos"))]
+impl Eq for ExternalSurface {}
