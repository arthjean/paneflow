+    /// Open a Vulkan device with the external-memory extensions that importing DMA-BUF
+    /// backed external surfaces needs, when the adapter is Vulkan and offers them.
+    /// `None` means the adapter is not Vulkan and the ordinary request path applies.
+    #[cfg(any(target_os = "linux", target_os = "freebsd"))]
+    fn request_vulkan_device_with_external_memory(
+        adapter: &wgpu::Adapter,
+        descriptor: &wgpu::DeviceDescriptor<'_>,
+    ) -> Option<anyhow::Result<(wgpu::Device, wgpu::Queue)>> {
+        use std::ffi::CStr;
+        use wgpu::hal::api::Vulkan;
+
+        if adapter.get_info().backend != wgpu::Backend::Vulkan {
+            return None;
+        }
+        let hal_adapter = unsafe { adapter.as_hal::<Vulkan>() }?;
+        let supported = unsafe {
+            hal_adapter
+                .shared_instance()
+                .raw_instance()
+                .enumerate_device_extension_properties(hal_adapter.raw_physical_device())
+        }
+        .ok()?;
+        let wanted: [&'static CStr; 8] = [
+            ash::khr::external_memory_fd::NAME,
+            ash::ext::external_memory_dma_buf::NAME,
+            ash::ext::image_drm_format_modifier::NAME,
+            ash::khr::image_format_list::NAME,
+            ash::khr::bind_memory2::NAME,
+            ash::khr::sampler_ycbcr_conversion::NAME,
+            ash::khr::external_semaphore_fd::NAME,
+            ash::ext::queue_family_foreign::NAME,
+        ];
+        let extra: Vec<&'static CStr> = wanted
+            .into_iter()
+            .filter(|name| {
+                supported.iter().any(|properties| {
+                    properties
+                        .extension_name_as_c_str()
+                        .is_ok_and(|supported_name| supported_name == *name)
+                })
+            })
+            .collect();
+        log::info!("Vulkan external-memory device extensions: {extra:?}");
+        let open = unsafe {
+            hal_adapter.open_with_callback(
+                descriptor.required_features,
+                &descriptor.required_limits,
+                &descriptor.memory_hints,
+                Some(Box::new(move |args| {
+                    for name in extra {
+                        if !args.extensions.contains(&name) {
+                            args.extensions.push(name);
+                        }
+                    }
+                })),
+            )
+        };
+        let open = match open {
+            Ok(open) => open,
+            Err(error) => {
+                return Some(Err(anyhow::anyhow!(
+                    "Failed to open Vulkan device with external-memory extensions: {error}"
+                )));
+            }
+        };
+        Some(
+            unsafe { adapter.create_device_from_hal::<Vulkan>(open, descriptor) }
+                .map_err(|e| anyhow::anyhow!("Failed to create wgpu device: {e}")),
+        )
+    }
