+
+struct ExternalSurface {
+    Bounds bounds;
+    Bounds content_mask;
+};
+
+struct ExternalSurfaceVertexOutput {
+    float4 position: SV_Position;
+    float2 texture_coords: TEXCOORD0;
+    float4 clip_distance: SV_ClipDistance;
+};
+
+StructuredBuffer<ExternalSurface> external_surfaces: register(t1);
+Texture2D<float4> t_external_surface: register(t0);
+SamplerState s_external_surface: register(s0);
+
+ExternalSurfaceVertexOutput external_surface_vertex(uint vertex_id: SV_VertexID, uint instance_id: SV_InstanceID) {
+    float2 unit_vertex = float2(float(vertex_id & 1u), 0.5 * float(vertex_id & 2u));
+    ExternalSurface surface = external_surfaces[instance_id];
+    ExternalSurfaceVertexOutput output;
+    output.position = to_device_position(unit_vertex, surface.bounds);
+    output.texture_coords = unit_vertex;
+    output.clip_distance = distance_from_clip_rect(unit_vertex, surface.bounds, surface.content_mask);
+    return output;
+}
+
+float4 external_surface_fragment(ExternalSurfaceVertexOutput input): SV_Target {
+    return t_external_surface.Sample(s_external_surface, input.texture_coords);
+}
