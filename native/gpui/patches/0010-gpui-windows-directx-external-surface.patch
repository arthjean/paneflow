+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ExternalSurfaceFormat {
+    Bgra8,
+    Rgba8,
+}
+
+pub struct ExternalD3D11Surface {
+    pub(crate) view: ID3D11ShaderResourceView,
+    pub(crate) width: u32,
+    pub(crate) height: u32,
+}
+
+#[derive(Clone)]
+pub struct ExternalSurfaceContext {
+    device: ID3D11Device,
+}
+
+impl ExternalSurfaceContext {
+    pub fn import_shared_texture(
+        &self,
+        handle: u64,
+        width: u32,
+        height: u32,
+        format: ExternalSurfaceFormat,
+    ) -> Result<ExternalD3D11Surface> {
+        anyhow::ensure!(handle != 0, "external surface handle is null");
+        anyhow::ensure!(width > 0 && height > 0, "external surface size is empty");
+        let device: ID3D11Device1 = self.device.cast().context("Opening D3D11 device")?;
+        let shared_handle = HANDLE(handle as usize as _);
+        let texture_result = unsafe { device.OpenSharedResource1(shared_handle) };
+        unsafe {
+            let _ = CloseHandle(shared_handle);
+        }
+        let texture: ID3D11Texture2D = texture_result.context("Opening shared external surface")?;
+        let mut desc = D3D11_TEXTURE2D_DESC::default();
+        unsafe { texture.GetDesc(&mut desc) };
+        let expected_format = match format {
+            ExternalSurfaceFormat::Bgra8 => DXGI_FORMAT_B8G8R8A8_UNORM,
+            ExternalSurfaceFormat::Rgba8 => DXGI_FORMAT_R8G8B8A8_UNORM,
+        };
+        anyhow::ensure!(desc.Width == width, "external surface width changed");
+        anyhow::ensure!(desc.Height == height, "external surface height changed");
+        anyhow::ensure!(desc.Format == expected_format, "external surface format changed");
+        anyhow::ensure!(desc.MipLevels == 1, "external surface has mip levels");
+        anyhow::ensure!(desc.ArraySize == 1, "external surface is an array");
+        anyhow::ensure!(desc.SampleDesc.Count == 1, "external surface is multisampled");
+        let mut view = None;
+        unsafe {
+            self.device
+                .CreateShaderResourceView(&texture, None, Some(&mut view))?;
+        }
+        Ok(ExternalD3D11Surface {
+            view: view.context("Creating external surface view")?,
+            width,
+            height,
+        })
+    }
+}
