+struct cef_paneflow_gpu_contract_info_v1 {
+  uint32_t abi_version;
+  uint32_t struct_size;
+  uint32_t status;
+  uint32_t flags;
+  uint64_t gpu_host_id;
+  uint64_t gpu_process_id;
+  uint64_t gpu_info_revision;
+  uint32_t vendor_id;
+  uint32_t device_id;
+  uint32_t skia_backend;
+  uint32_t gl_implementation;
+  uint32_t angle_implementation;
+  uint32_t reserved;
+};
+
+static_assert(sizeof(cef_paneflow_gpu_contract_info_v1) == 64);
+static_assert(offsetof(cef_paneflow_gpu_contract_info_v1, gpu_host_id) == 16);
+
+extern "C" CEF_EXPORT int32_t cef_paneflow_gpu_contract_v1(
+    uint32_t output_size,
+    cef_paneflow_gpu_contract_info_v1* output) {
+  if (!output || output_size != sizeof(*output)) {
+    return 1;
+  }
+  *output = {};
+  output->abi_version = 1;
+  output->struct_size = sizeof(*output);
+  const auto result = [output](int32_t status) {
+    output->status = status;
+    return status;
+  };
+  if (!CONTEXT_STATE_VALID()) {
+    return result(2);
+  }
+  if (!CEF_CURRENTLY_ON_UIT()) {
+    return result(3);
+  }
+#if BUILDFLAG(IS_LINUX) && !BUILDFLAG(IS_CHROMEOS)
+  auto* host = content::GpuProcessHost::Get(
+      content::GPU_PROCESS_KIND_SANDBOXED, false);
+  if (!host) {
+    return result(4);
+  }
+  uint64_t revision = 0;
+  const auto* info = host->PaneflowInitializedGPUInfo(&revision);
+  if (!info) {
+    return result(5);
+  }
+  output->gpu_host_id = static_cast<uint64_t>(host->host_id());
+  output->gpu_process_id = static_cast<uint64_t>(host->process_id());
+  output->gpu_info_revision = revision;
+  output->flags = 1u | (info->sandboxed ? 2u : 0u) | (info->UsesSwiftShader() ? 4u : 0u);
+  output->skia_backend =
+      info->skia_backend_type == gpu::SkiaBackendType::kGaneshGL ? 1u : 0u;
+  output->gl_implementation =
+      info->gl_implementation_parts.gl == gl::kGLImplementationEGLANGLE ? 1u : 0u;
+  output->angle_implementation =
+      info->gl_implementation_parts.angle == gl::ANGLEImplementation::kVulkan
+          ? 1u : 0u;
+  size_t active = info->gpu.active ? 1u : 0u;
+  for (const auto& gpu : info->secondary_gpus) {
+    active += gpu.active ? 1u : 0u;
+  }
+  if (active != 1 && !info->secondary_gpus.empty()) {
+    return result(6);
+  }
+  const auto& gpu = info->active_gpu();
+  output->vendor_id = gpu.vendor_id;
+  output->device_id = gpu.device_id;
+  if (output->flags != 3 || output->skia_backend != 1 ||
+      output->gl_implementation != 1 || output->angle_implementation != 1 ||
+      output->vendor_id == 0 || output->device_id == 0) {
+    return result(6);
+  }
+  return result(0);
+#else
+  return result(7);
+#endif
+}
